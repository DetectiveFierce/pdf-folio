theme "light" {
    // Soft paper light with clear surface steps
    color "background" "#EDE9E1"
    color "surface" "#FBF9F4"
    color "surface_raised" "#FFFFFF"
    color "text_primary" "#1F1810"
    color "text_secondary" "#6E5A42"
    color "accent" "#A67C2E"
    color "border" "#D4CBB8"
    color "error" "#B03040"
    color "canvas" "#E4DDD2"
    color "placeholder" "#E8E0D2"
    color "focus" "#A67C2E"
    color "shadow" "#1F181029"

    primitive "page_shadow_offset_x" 0
    primitive "page_shadow_offset_y" 3
    primitive "progress_girth" 3
}
