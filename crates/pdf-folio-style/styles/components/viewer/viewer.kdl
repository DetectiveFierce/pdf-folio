primitive "viewer_find_fill" "#FFB92285"
primitive "viewer_find_selected_fill" "#DE7F00AD"
primitive "viewer_text_selection_mix" 0.72
primitive "viewer_text_selection_alpha" 0.42
primitive "slider_rail_width" 4
primitive "slider_handle_radius" 7
primitive "scrollbar_width" 4
primitive "scrollbar_scroller_width" 2
primitive "sidebar_scrollbar_width" 4
primitive "sidebar_scrollbar_scroller_width" 2
primitive "scrollbar_radius" 6
primitive "auto_scroll_radius" 999
primitive "auto_scroll_shadow_blur" 4

component "ViewerToolbar" {
    layout title_min_width=28 title_max_width=360 selection_width=116

    normal background="#0E0904" text="#DDD0BA" border="#C8B89A1A" border_width=1 radius=0 theme="espresso"
    normal background="#FCFAF5" text="#261E14" border="#D8CEBC" border_width=1 radius=0 theme="light"
}

component "ViewerToolbarButton" {
    normal background="#1E1409" text="#C8B89A" border="#C8B89A2E" border_width=1 radius=6 theme="espresso"
    hovered background="#2B1D0E" text="#DDD0BA" border="#D4A85359" theme="espresso"
    pressed background="#352511" text="#D4A853" border="#D4A853" theme="espresso"

    normal background="#F6F2EA" text="#261E14" border="#D8CEBC" border_width=1 radius=6 theme="light"
    hovered background="#EAE0CF" text="#9C732B" border="#9C732B66" theme="light"
    pressed background="#DED1BC" text="#9C732B" border="#9C732B" theme="light"
}

component "ViewerToolbarTitle" {
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerPageControl" {
    layout number_width=42 control_width=150 chevron_size=28

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerZoomControl" {
    layout control_width=98 menu_width=118 menu_row_height=22 input_width=58 button_size=28 button_padding=0 icon_size=16 menu_padding=0

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerZoomMenu" {
    normal background="#23180C" text="$text_primary" border="#C8B89A2E" border_width=1 radius=6 theme="espresso"
    normal background="#F6F2EA" text="$text_primary" border="#D8CEBC" border_width=1 radius=6 theme="light"
}

component "ViewerZoomMenuItem" {
    layout padding_x=6 padding_y=0

    normal background="#23180C" text="$text_primary" border="#00000000" border_width=0 radius=0 theme="espresso"
    hovered background="#2B1D0E" text="$accent" border="#D4A85340" border_width=1 theme="espresso"
    pressed background="#352511" text="$accent" border="#D4A853" theme="espresso"

    normal background="#F6F2EA" text="$text_primary" border="#00000000" border_width=0 radius=0 theme="light"
    hovered background="#EAE0CF" text="$accent" border="#9C732B66" border_width=1 theme="light"
    pressed background="#DED1BC" text="$accent" border="#9C732B" theme="light"
}

component "ViewerSidebar" {
    layout width=228

    normal background="#0E0904" text="#DDD0BA" border="#C8B89A1A" border_width=1 radius=0 theme="espresso"
    normal background="#FCFAF5" text="#261E14" border="#D8CEBC" border_width=1 radius=0 theme="light"
}

component "ViewerSidebarTab" {
    normal background="#0E0904" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    hovered background="#160F07" text="$text_primary" border="#00000000" theme="espresso"
    active background="#201409" text="$accent" border="$accent" border_width=1 theme="espresso"

    normal background="#FCFAF5" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
    hovered background="#F6F2EA" text="$text_primary" border="#00000000" theme="light"
    active background="#EAE0CF" text="$accent" border="$accent" border_width=1 theme="light"
}

component "ViewerOutlineEntry" {
    normal background="#0E0904" text="$text_secondary" border="#00000000" border_width=0 radius=4 theme="espresso"
    hovered background="#160F07" text="$text_primary" theme="espresso"
    pressed background="#211609" text="$accent" theme="espresso"

    normal background="#FCFAF5" text="$text_secondary" border="#00000000" border_width=0 radius=4 theme="light"
    hovered background="#F6F2EA" text="$text_primary" theme="light"
    pressed background="#EAE0CF" text="$accent" theme="light"
}

component "ViewerThumbnail" {
    layout width_px=128

    normal background="#211609" text="$text_secondary" border="#C8B89A1A" border_width=1 radius=6 theme="espresso"
    normal background="#F6F2EA" text="$text_secondary" border="#D8CEBC" border_width=1 radius=6 theme="light"
}

component "ViewerFindBar" {
    layout width=600 height=42 input_width=140 counter_width=44 button_size=30 button_padding=0 icon_size=16 checkbox_size=16

    normal background="#23180C" text="#DDD0BA" border="#D4A85359" border_width=1 radius=8 theme="espresso"
    normal theme="espresso" {
        radius top_left=8 top_right=0 bottom_right=0 bottom_left=0
        shadow color="$shadow" offset_x=0 offset_y=8 blur=18
    }
    normal background="#FCFAF5" text="#261E14" border="#9C732B66" border_width=1 radius=8 theme="light"
    normal theme="light" {
        radius top_left=8 top_right=0 bottom_right=0 bottom_left=0
        shadow color="$shadow" offset_x=0 offset_y=8 blur=18
    }
}

component "ViewerFindInput" {
    normal background="#1B1208" text="#DDD0BA" border="#C8B89A2E" border_width=1 radius=6 theme="espresso"
    focused background="#23180C" text="#DDD0BA" border="#D4A853" theme="espresso"
    hovered background="#23180C" text="#DDD0BA" border="#D4A85359" theme="espresso"

    normal background="#FCFAF5" text="#261E14" border="#D8CEBC" border_width=1 radius=6 theme="light"
    focused background="#FFFFFF" text="#261E14" border="#9C732B" theme="light"
    hovered background="#FFFFFF" text="#261E14" border="#9C732B66" theme="light"
}

component "ViewerFindButton" {
    normal background="#1E1409" text="#C8B89A" border="#C8B89A2E" border_width=1 radius=6 theme="espresso"
    hovered background="#2B1D0E" text="#DDD0BA" border="#D4A85359" theme="espresso"
    pressed background="#352511" text="#D4A853" border="#D4A853" theme="espresso"

    normal background="#F6F2EA" text="#261E14" border="#D8CEBC" border_width=1 radius=6 theme="light"
    hovered background="#EAE0CF" text="#9C732B" border="#9C732B66" theme="light"
    pressed background="#DED1BC" text="#9C732B" border="#9C732B" theme="light"
}

component "ViewerCanvas" {
    normal background="#170E05" text="#DDD0BA" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#E8E2D8" text="#261E14" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerPagePlaceholder" {
    normal background="#211609" text="#8B6E52" border="#C8B89A1A" border_width=1 radius=6 theme="espresso"
    normal background="#F6F2EA" text="#745F46" border="#D8CEBC" border_width=1 radius=6 theme="light"
}

component "ViewerPresentationOverlay" {
    normal background="#170E05B8" text="#DDD0BA" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#E8E2D8B8" text="#261E14" border="#00000000" border_width=0 radius=0 theme="light"
}
