component "Sidebar" {
    layout width=270 min_width=210 max_width=340 resize_handle_width=8 resize_handle_visual_width=2

    normal background="#14100B" text="#F0E6D4" border="#C8B89A24" border_width=1 radius=0 theme="espresso"
    normal background="#F7F3EA" text="#1F1810" border="#D4CBB8" border_width=1 radius=0 theme="light"
}

component "SidebarSection" {
    normal background="#00000000" text="#A89072" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="#6E5A42" border="#00000000" border_width=0 radius=0 theme="light"
}

component "SidebarRow" {
    normal background="#00000000" text="#C8B89A" border="#00000000" border_width=0 radius=0 theme="espresso"
    hovered background="#241A10" text="#F0E6D4" border="#00000000" theme="espresso"
    selected background="#E0B45A22" text="#E0B45A" border="#00000000" border_width=0 theme="espresso"
    active background="#E0B45A28" text="#E0B45A" border="#00000000" border_width=0 theme="espresso"

    normal background="#00000000" text="#6E5A42" border="#00000000" border_width=0 radius=0 theme="light"
    hovered background="#EDE5D6" text="#1F1810" border="#00000000" theme="light"
    selected background="#E8D5A8" text="#8A6520" border="#00000000" border_width=0 theme="light"
    active background="#E8D5A8" text="#8A6520" border="#00000000" border_width=0 theme="light"
}

component "SidebarToggleButton" {
    normal background="#00000000" text="#C8B89A" border="#00000000" border_width=0 radius=6 theme="espresso"
    hovered background="#241A10" text="#F0E6D4" border="#C8B89A30" border_width=1 theme="espresso"
    pressed background="#2E2214" text="#E0B45A" border="#E0B45A55" border_width=1 theme="espresso"

    normal background="#00000000" text="#6E5A42" border="#00000000" border_width=0 radius=6 theme="light"
    hovered background="#EDE5D6" text="#1F1810" border="#D4CBB8" border_width=1 theme="light"
    pressed background="#E6D9C4" text="#A67C2E" border="#A67C2E66" border_width=1 theme="light"
}

component "SidebarTab" {
    layout height=30 width_portion=1 spacing=0 {
        padding 4 9
        margin 0
    }
    text size=13 weight="medium"
    labels {
        label "Files" "Files"
        label "Tags" "Tags"
    }

    normal theme="espresso" {
        colors background="#100C07" text="#8A7358" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    hovered theme="espresso" {
        colors background="#1E1610" text="#C8B89A" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    pressed theme="espresso" {
        colors background="#241A10" text="#D8C9B0" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    active theme="espresso" {
        colors background="#1A140E" text="#E0B45A" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }

    normal theme="light" {
        colors background="#EDE9E1" text="$text_secondary" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    hovered theme="light" {
        colors background="#E6DFD2" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    pressed theme="light" {
        colors background="#DDD4C4" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
    active theme="light" {
        colors background="#F7F3EA" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius top_left=6 top_right=6 bottom_right=0 bottom_left=0
    }
}

component "FileTree" {
    layout height=28 padding_top=0
    text size=14 weight="medium"

    normal theme="espresso" {
        colors background="#00000000" text="$text_secondary" border="#00000000"
        border width=0 color="#00000000"
        radius 0
    }
    hovered theme="espresso" {
        colors background="#241A10" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 0
    }
    active theme="espresso" {
        colors background="#E0B45A22" text="$text_primary" border="#00000000"
        border width=0 color="#00000000" {
            left width=3 color="$accent"
        }
        radius 0
    }

    normal theme="light" {
        colors background="#00000000" text="$text_secondary" border="#00000000"
        border width=0 color="#00000000"
        radius 0
    }
    hovered theme="light" {
        colors background="#EDE5D6" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 0
    }
    active theme="light" {
        colors background="#E8D5A8" text="$text_primary" border="#00000000"
        border width=0 color="#00000000" {
            left width=3 color="$accent"
        }
        radius 0
    }
}

component "FileTreeFoldButton" {
    layout width=16 height=20 padding=0

    normal theme="espresso" {
        colors background="#00000000" text="$text_secondary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }
    hovered theme="espresso" {
        colors background="#241A10" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }
    pressed theme="espresso" {
        colors background="#332616" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }

    normal theme="light" {
        colors background="#00000000" text="$text_secondary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }
    hovered theme="light" {
        colors background="#EDE5D6" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }
    pressed theme="light" {
        colors background="#E6D9C4" text="$text_primary" border="#00000000"
        border width=0 color="#00000000"
        radius 4
    }
}

component "SidebarDetailPanel" {
    normal background="#17110A" text="#D8C9B0" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#FBF9F4" text="#1F1810" border="#00000000" border_width=0 radius=0 theme="light"
}

component "SidebarDetailRow" {
    normal background="#1E1610" text="#D8C9B0" border="#C8B89A22" border_width=1 radius=8 theme="espresso"
    hovered background="#241A10" text="#E8DCC8" border="#C8B89A38" theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#F5F1E8" text="#1F1810" border="#C4B89E" theme="light"
}

component "SidebarFolderCard" {
    normal background="#1E1610" text="#C8B89A" border="#C8B89A22" border_width=1 radius=8 theme="espresso"
    hovered background="#241A10" text="#D8C9B0" border="#C8B89A38" theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#F5F1E8" text="#1F1810" border="#C4B89E" theme="light"
}

component "SidebarFolderCardTitle" {
    normal background="#00000000" text="#A89072" border="#00000000" border_width=0 radius=0 theme="espresso"

    normal background="#00000000" text="#6E5A42" border="#00000000" border_width=0 radius=0 theme="light"
}

component "SidebarFolderTextInput" {
    normal background="#120E09" text="#D8C9B0" border="#C8B89A30" border_width=1 radius=8 theme="espresso"
    hovered background="#1A140E" text="#E8DCC8" border="#C8B89A45" border_width=1 radius=8 theme="espresso"
    focused background="#1E1610" text="#F0E6D4" border="#E0B45A" border_width=1 radius=8 theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#FBF9F4" text="#1F1810" border="#C4B89E" border_width=1 radius=8 theme="light"
    focused background="#FFFFFF" text="#1F1810" border="#A67C2E" border_width=1 radius=8 theme="light"
}

component "SidebarFolderActionButton" {
    normal background="#1E1610" text="#D8C9B0" border="#C8B89A30" border_width=1 radius=8 theme="espresso"
    hovered background="#2A2014" text="#F0E6D4" border="#E0B45A55" theme="espresso"
    pressed background="#352814" text="#E0B45A" border="#E0B45A99" theme="espresso"
    disabled background="#16120C" text="#6E5A48" border="#C8B89A18" border_width=1 radius=8 theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#F0EAE0" text="#A67C2E" border="#A67C2E66" theme="light"
    pressed background="#E6D9C4" text="#A67C2E" border="#A67C2E" theme="light"
    disabled background="#F0EBE3" text="#A89884" border="#D4CBB880" border_width=1 radius=8 theme="light"
}

component "SidebarActionButton" {
    normal background="#1E1610" text="#E0B45A" border="#E0B45A40" border_width=1 radius=8 theme="espresso"
    hovered background="#2A2014" text="#F0C870" border="#E0B45A80" theme="espresso"
    pressed background="#352814" text="#F0C870" border="#E0B45A" theme="espresso"

    normal background="#FFFFFF" text="#8A6520" border="#A67C2E55" border_width=1 radius=8 theme="light"
    hovered background="#F0EAE0" text="#A67C2E" border="#A67C2E88" theme="light"
    pressed background="#E6D9C4" text="#A67C2E" border="#A67C2E" theme="light"
}
