primitive "viewer_find_fill" "#FFB92285"
primitive "viewer_find_selected_fill" "#DE7F00AD"
// Classic highlighter yellow (mockup --highlight / --highlight-strong), kept
// distinct from find-in-document amber fills. Fills stay soft so text remains
// readable; selected ranges get emphasis from the accent stroke, not fill alpha.
primitive "viewer_annotation_fill" "#F4CE7259"
primitive "viewer_annotation_selected_fill" "#EFB53D73"
primitive "viewer_text_selection_mix" 0.72
primitive "viewer_text_selection_alpha" 0.42
primitive "slider_rail_width" 4
primitive "slider_handle_radius" 7
primitive "scrollbar_width" 4
primitive "scrollbar_scroller_width" 2
primitive "sidebar_scrollbar_width" 4
primitive "sidebar_scrollbar_scroller_width" 2
primitive "scrollbar_radius" 6
primitive "auto_scroll_radius" 999
primitive "auto_scroll_shadow_blur" 4

component "ViewerToolbar" {
    // spacing = gap between adjacent controls (not internal button padding).
    layout height=48 spacing=10 padding_x=10 padding_y=6 title_min_width=28 title_max_width=360 selection_width=116

    normal background="#17110A" text="#F0E6D4" border="#C8B89A24" border_width=1 radius=0 theme="espresso"
    normal background="#FBF9F4" text="#1F1810" border="#D4CBB8" border_width=1 radius=0 theme="light"
}

component "ViewerToolbarButton" {
    layout spacing=4 padding_x=12 padding_y=6
    text size=13 weight="medium"

    normal background="#1E1610" text="#D8C9B0" border="#C8B89A30" border_width=1 radius=8 theme="espresso"
    hovered background="#2A2014" text="#F0E6D4" border="#E0B45A55" theme="espresso"
    pressed background="#352814" text="#E0B45A" border="#E0B45A" theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#F0EAE0" text="#A67C2E" border="#A67C2E66" theme="light"
    pressed background="#E6D9C4" text="#A67C2E" border="#A67C2E" theme="light"
}

component "ViewerToolbarTitle" {
    text size=14 weight="medium"

    normal background="#00000000" text="$text_primary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_primary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerPageControl" {
    // Compact pill: [‹] current / total [›] — tighter than the old loose row.
    layout number_width=36 control_width=132 chevron_size=26 spacing=2 padding_x=4 padding_y=2
    text size=13 weight="medium"

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerZoomControl" {
    layout control_width=98 menu_width=118 menu_row_height=24 input_width=58 button_size=28 button_padding=0 icon_size=16 menu_padding=0

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerZoomMenu" {
    normal background="#241A10" text="$text_primary" border="#C8B89A40" border_width=1 radius=10 theme="espresso"
    normal background="#FFFFFF" text="$text_primary" border="#D4CBB8" border_width=1 radius=10 theme="light"
}

component "ViewerZoomMenuItem" {
    layout padding_x=8 padding_y=2

    normal background="#00000000" text="$text_primary" border="#00000000" border_width=0 radius=6 theme="espresso"
    hovered background="#332616" text="$accent" border="#00000000" border_width=0 theme="espresso"
    pressed background="#3A2C18" text="$accent" border="#00000000" theme="espresso"

    normal background="#00000000" text="$text_primary" border="#00000000" border_width=0 radius=6 theme="light"
    hovered background="#F0EAE0" text="$accent" border="#00000000" border_width=0 theme="light"
    pressed background="#E6D9C4" text="$accent" border="#00000000" theme="light"
}

component "ViewerSidebar" {
    layout width=228

    normal background="#14100B" text="#F0E6D4" border="#C8B89A24" border_width=1 radius=0 theme="espresso"
    normal background="#F7F3EA" text="#1F1810" border="#D4CBB8" border_width=1 radius=0 theme="light"
}

component "ViewerSidebarTab" {
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=6 theme="espresso"
    hovered background="#241A10" text="$text_primary" border="#00000000" theme="espresso"
    active background="#E0B45A22" text="$accent" border="#00000000" border_width=0 theme="espresso"

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=6 theme="light"
    hovered background="#EDE5D6" text="$text_primary" border="#00000000" theme="light"
    active background="#E8D5A8" text="$accent" border="#00000000" border_width=0 theme="light"
}

component "ViewerOutlineEntry" {
    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=6 theme="espresso"
    hovered background="#241A10" text="$text_primary" theme="espresso"
    pressed background="#2E2214" text="$accent" theme="espresso"
    active background="#E0B45A22" text="$accent" border="#00000000" border_width=0 radius=6 theme="espresso"

    normal background="#00000000" text="$text_secondary" border="#00000000" border_width=0 radius=6 theme="light"
    hovered background="#EDE5D6" text="$text_primary" theme="light"
    pressed background="#E6D9C4" text="$accent" theme="light"
    active background="#E8D5A8" text="$accent" border="#00000000" border_width=0 radius=6 theme="light"
}

component "ViewerThumbnail" {
    layout width_px=128

    normal background="#1E1610" text="$text_secondary" border="#C8B89A28" border_width=1 radius=8 theme="espresso"
    normal background="#FFFFFF" text="$text_secondary" border="#D4CBB8" border_width=1 radius=8 theme="light"
}

component "ViewerFindBar" {
    layout width=420 height=44 input_width=160 counter_width=56 button_size=30 button_padding=0 icon_size=16 checkbox_size=16

    normal background="#241A10" text="#F0E6D4" border="#E0B45A55" border_width=1 radius=10 theme="espresso"
    normal theme="espresso" {
        radius top_left=10 top_right=0 bottom_right=0 bottom_left=0
        shadow color="$shadow" offset_x=0 offset_y=10 blur=22
    }
    normal background="#FFFFFF" text="#1F1810" border="#A67C2E66" border_width=1 radius=10 theme="light"
    normal theme="light" {
        radius top_left=10 top_right=0 bottom_right=0 bottom_left=0
        shadow color="$shadow" offset_x=0 offset_y=8 blur=18
    }
}

component "ViewerFindInput" {
    normal background="#1A140E" text="#F0E6D4" border="#C8B89A38" border_width=1 radius=8 theme="espresso"
    focused background="#1E1610" text="#F0E6D4" border="#E0B45A" theme="espresso"
    hovered background="#1E1610" text="#F0E6D4" border="#E0B45A55" theme="espresso"

    normal background="#F5F1E8" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    focused background="#FFFFFF" text="#1F1810" border="#A67C2E" theme="light"
    hovered background="#FFFFFF" text="#1F1810" border="#A67C2E66" theme="light"
}

component "ViewerFindButton" {
    normal background="#1E1610" text="#D8C9B0" border="#C8B89A30" border_width=1 radius=8 theme="espresso"
    hovered background="#2A2014" text="#F0E6D4" border="#E0B45A55" theme="espresso"
    pressed background="#352814" text="#E0B45A" border="#E0B45A" theme="espresso"

    normal background="#FFFFFF" text="#1F1810" border="#D4CBB8" border_width=1 radius=8 theme="light"
    hovered background="#F0EAE0" text="#A67C2E" border="#A67C2E66" theme="light"
    pressed background="#E6D9C4" text="#A67C2E" border="#A67C2E" theme="light"
}

component "ViewerCanvas" {
    normal background="#0C0905" text="#F0E6D4" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#E4DDD2" text="#1F1810" border="#00000000" border_width=0 radius=0 theme="light"
}

component "ViewerPagePlaceholder" {
    normal background="#1E1610" text="#A89072" border="#C8B89A28" border_width=1 radius=8 theme="espresso"
    normal background="#F0EAE0" text="#6E5A42" border="#D4CBB8" border_width=1 radius=8 theme="light"
}

component "ViewerPresentationOverlay" {
    normal background="#0C0905B8" text="#F0E6D4" border="#00000000" border_width=0 radius=0 theme="espresso"
    normal background="#E4DDD2B8" text="#1F1810" border="#00000000" border_width=0 radius=0 theme="light"
}

component "AnnotationPopover" {
    layout padding_x=20 padding_y=18 spacing=8 width=320

    // Solid paper cards with soft elevation (mockup comment carousel).
    normal background="#241A10F2" text="#F0E6D4" border="#C8B89A66" border_width=1 radius=14 theme="espresso"
    normal background="#FFFFFFF5" text="#1F1810" border="#DAD9CE" border_width=1 radius=14 theme="light"
}

component "AnnotationToolbar" {
    layout spacing=4 padding_x=8 padding_y=4

    normal background="#1E1610AA" text="#D8C9B0" border="#C8B89A40" border_width=1 radius=8 theme="espresso"
    normal background="#FFFFFFCC" text="#1F1810" border="#D4CBB8AA" border_width=1 radius=8 theme="light"
}
