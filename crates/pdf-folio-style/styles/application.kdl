component "AppWindow" {
    layout width=960 height=1080
}

component "ViewerSidebar" {
    layout width=228
}

component "AppMenuBar" {
    layout height=32 file_width=48 edit_width=48 view_width=56 document_width=88 library_width=68 tools_width=58 help_width=56
}

component "AppMenuPanel" {
    layout width=270 item_height=30
}

component "ContextMenuPanel" {
    layout width=250 item_height=30
}

component "CommandPalette" {
    layout width=520 list_height=420 icon_slot_width=12 metadata_spacing=1
}

component "SignedOutPanel" {
    layout width=420
}

component "JumpOverlay" {
    layout input_width=90
}

component "LibrarySwitcher" {
    layout card_width=230 card_height=362 card_overlay_gutter=72 card_top_spacer=12 card_title_height=38 card_title_size=18 card_title_spacing=2 heading_size=34 create_icon_size=48 create_top_extra=12
}

component "LibraryToolbar" {
    layout compact_width=760 narrow_width=600 breadcrumb_width=150 breadcrumb_narrow_width=94 filter_pill_width=170 filter_pill_narrow_width=112 reorder_hint_width=190 reorder_hint_narrow_width=118
}

component "LibrarySearchInput" {
    layout clear_icon_size=12 clear_button_size=24 clear_button_padding=0
}

component "LibraryHistoryButton" {
    layout icon_size=16 center_size=20 button_size=32
}

component "LibrarySyncIndicator" {
    layout size=30 icon_size=14 spinner_size=14
}

component "LibraryEntry" {
    layout card_tag_row_left_shift=-4 row_checkbox_lane_width=24 row_floating_width=720 thumbnail_max_height_ratio=1.32
}

component "LibraryInteraction" {
    layout card_hover_lift=2 row_hover_lift=1 grid_zoom_min=0.25 grid_zoom_max=12 grid_zoom_step=0.05 grid_zoom_dense_column_cap=28
}

component "LibrarySwitcherPreview" {
    layout columns=4 rows=3 height=280 tile_width=48 tile_height=77 row_height=77 row_offset=5 column_gap=5 ellipsis_row_height=25 panel_padding=4 image_width=38 image_slot_height=49 image_min_height=28 title_font_size=8 title_height=22 title_lines=3 title_inset=4 tile_spacing=2 tile_padding=2 ellipsis_icon_width=6 ellipsis_icon_height=34
}

component "LibrarySwitcherMenu" {
    layout x=7 y=2 offset=6 down_shift=4 width=118 icon_width=18 icon_height=6 button_width=28 button_height=22 button_padding=0
}

component "ConfirmationDialog" {
    layout width=420
}

component "DeleteFolderConfirmationDialog" {
    layout width=520
}

component "CreateFolderDialog" {
    layout width=420
}

component "LibraryMovePickerDialog" {
    layout width=540 tree_width=480 tree_height=330
}

component "RaindropConnectDialog" {
    layout width=560
}

component "RaindropImportDialog" {
    layout width=820 height=660 pdf_panel_height=360
}

component "RaindropImportProgressDialog" {
    layout width=460 title_width=400
}

component "RaindropImportLocationSelector" {
    layout width=320 menu_height=220
}

component "LibraryNameDialog" {
    layout width=360
}

component "StartupLoadingDialog" {
    layout width=460
}

component "ErrorBannerAction" {
    layout action_width=32
}

component "ViewerToolbarChrome" {
    layout fixed_width=620 library_button_width=70 open_button_width=87 zoom_step_button_width=30 selection_button_width=76 icon_size=16
}

component "AppMenu" {
    labels {
        label "File" "File"
        label "Edit" "Edit"
        label "View" "View"
        label "Document" "Document"
        label "Library" "Library"
        label "Tools" "Tools"
        label "Help" "Help"
    }
}

component "AppMenuActions" {
    labels {
        label "OpenFile" "Open PDF..."
        label "ImportFolder" "Import Folder..."
        label "UploadFolder" "Upload Folder..."
        label "BackToLibrary" "Back to Library"
        label "RefreshLibrary" "Refresh Library"
        label "SelectAllVisible" "Select All Visible PDFs"
        label "ClearSelection" "Clear Selection"
        label "SaveDetails" "Save Details"
        label "ResetDetails" "Reset Details..."
        label "AddTag" "Add Typed Tag"
        label "RemoveTag" "Remove Typed Tag"
        label "AddToFolder" "Add Selection to Current Folder"
        label "RemoveFromFolder" "Remove Selection from Current Folder"
        label "DeleteFromLibrary" "Move to Trash..."
        label "ToggleLayoutGrid" "Switch to Grid"
        label "ToggleLayoutList" "Switch to List"
        label "ToggleThemeDark" "Switch to Dark Theme"
        label "ToggleThemeLight" "Switch to Light Theme"
        label "ReloadStyles" "Reload Styles"
        label "ToggleTocHide" "Hide Table of Contents"
        label "ToggleTocShow" "Show Table of Contents"
        label "JumpToPage" "Jump to Page..."
        label "ZoomIn" "Zoom In"
        label "ZoomOut" "Zoom Out"
        label "ResetZoom" "Reset Zoom"
        label "CreateFolder" "New Folder..."
        label "ResetMetadata" "Reset Display Metadata..."
        label "SortTitles" "Apply Title Sort Cleanup"
        label "RefreshMetadata" "Refresh PDF Metadata"
        label "RebuildThumbnails" "Rebuild Thumbnails"
        label "Reindex" "Reindex Full Text"
    }
}

component "HelpPanel" {
    labels {
        label "help_product_name" "PDF-Folio"
        label "help_product_detail" "Local PDF library and reader"
        label "help_status_label" "Status"
        label "help_status_detail" "No help actions available yet"
        label "sort_selected" "Selected"
    }
}
