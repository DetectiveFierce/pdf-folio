theme "espresso" {
    // Layered warm dark: canvas → panel → raised chrome
    color "background" "#100C07"
    color "surface" "#17110A"
    color "surface_raised" "#241A10"
    color "text_primary" "#F0E6D4"
    color "text_secondary" "#A89072"
    color "accent" "#E0B45A"
    color "border" "#C8B89A38"
    color "error" "#E85A5A"
    color "canvas" "#0C0905"
    color "placeholder" "#2E2214"
    color "focus" "#E0B45A"
    color "shadow" "#000000A6"

    primitive "page_shadow_offset_x" 0
    primitive "page_shadow_offset_y" 4
    primitive "progress_girth" 3
}
